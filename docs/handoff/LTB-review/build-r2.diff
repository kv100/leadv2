+# ── Run all tests ──────────────────────────────────────────────────────────────
+test_d1_process_alive
+test_d1_reap_worker
+test_d2_fallback_frontmatter
+test_d3_no_block
+test_d4_grace_guard
+test_d5_reorder_signal
+
+printf '\n[PLUGIN-RELIABILITY-01] passed=%d failed=%d\n' "$PASS" "$FAIL"
+(( FAIL == 0 ))
