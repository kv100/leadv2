+else
+  fail "resolver --job plan pool INCLUDES glm (pool=${_pool_line})"
+fi
+
+printf -- '\nResults: %d pass, %d fail\n' "${PASS}" "${FAIL}"
+[[ "${FAIL}" == "0" ]] || exit 1
+exit 0
