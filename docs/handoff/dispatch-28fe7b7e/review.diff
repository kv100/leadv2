+
+  if [[ -z "$HOOK_OUT" ]] && [[ "$HOOK_ERR" == *"goal reached"* ]]; then
+    pass "case 16: satisfied file_exists goal allows stop"
+  else
+    fail "case 16: expected empty stdout + 'goal reached' stderr, got: out=$HOOK_OUT err=$HOOK_ERR"
+  fi
+}
