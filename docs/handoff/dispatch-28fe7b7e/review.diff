+# ════════════════════════════════════════════════════════════════════════════
+# Case 14: writable state dir, regression guard — still reaches the cap at 8
+# (proves F1's fix did not disable the cap).
+# ════════════════════════════════════════════════════════════════════════════
+{
+  TASKS_YAML='- id: task-aaa
+  status: queued
+  lane: main
+  title: "Implement feature A"
