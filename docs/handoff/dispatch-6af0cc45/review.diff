   done < "${FINDINGS_DEDUP}"
   printf ']}'
 } > "${FINDINGS_JSON}.tmp"
@@ -722,9 +852,12 @@ fi
 
 if [[ "${verdict}" == FAIL ]]; then
   {
+    printf 'summary: %s\n' "$(gate_summary_line)"
     printf 'arms: %s\n%s\n' "${ARMS_CSV}" "${VERIFIED_LINE}"
