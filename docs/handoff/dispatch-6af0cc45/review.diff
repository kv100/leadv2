@@ -231,6 +231,130 @@ review_floor_ok() { # <file> -> 0 if it clears the floor, 1 if not
   return 0
 }
 
+# ---------------------------------------------------------------------------
+# 3b. REVIEW-GATE-SHOWS-FINDINGS-01 — the human surface of review-gate.md.
+# The machine header (status:/critical:/high:/medium:/low:) stays byte-identical;
+# everything here is additive. Source of truth is .review-findings-render.tsv,
+# a sidecar the JSON-build loop below appends to as it walks the dedup TSV
+# (no JSON parsing on this path — same reason the JSON is built, not re-read).
+# ---------------------------------------------------------------------------
+RENDER_TSV="${HANDOFF}/.review-findings-render.tsv"
+
+# <desc> -> sanitised one-liner, clipped to LEADV2_REVIEW_GATE_DESC_CHARS.
+# A model-authored desc may contain anything: CR/LF are stripped and whitespace
+# runs collapsed so one finding is exactly one line and cannot forge a `status:`
+# line downstream (leadv2-phase-record.sh greps '^status:').
+_review_gate_clip_desc() { # <desc>
+  local d="$1"
+  local max="${LEADV2_REVIEW_GATE_DESC_CHARS:-160}"
+  d="$(printf '%s' "${d}" | tr -d '\r\n' | tr -s '[:space:]' ' ')"
+  d="${d# }"
+  d="$(printf '%s' "${d}" | sed -E 's/^(status|arms|verified):[[:space:]]*//')"
+  if (( ${#d} > max )); then
+    printf '%s…' "${d:0:max}"
+  else
+    printf '%s' "${d}"
+  fi
+}
+
+# Per-arm tally line: an arm that returned nothing shows as =0, visibly silent
+# rather than invisibly absent (mission requirement: never let one arm's silence
+# mask another's findings).
+_review_gate_by_arm_line() {
+  local out="" _a _n
+  for _a in ${ran_arms[@]+"${ran_arms[@]}"}; do
+    _n="$(awk -F'\t' -v a="${_a}" '$4==a' "${RENDER_TSV}" 2>/dev/null | wc -l | tr -d '[:space:]')"; _n="${_n:-0}"
+    out="${out:+${out} }${_a}=${_n}"
+  done
+  _n="$(awk -F'\t' '$4=="hackdetect"' "${RENDER_TSV}" 2>/dev/null | wc -l | tr -d '[:space:]')"; _n="${_n:-0}"
+  [[ "${_n}" -gt 0 ]] && out="${out:+${out} }hackdetect=${_n}"
+  printf '  by_arm: %s\n' "${out:-none}"
+}
+
+# Critical+High+Medium row count in the render TSV (Low excluded — it is
+# accounted for separately and never rendered as rows).
+_review_gate_med_rows() {
+  awk -F'\t' '{s=tolower($1); if (s=="critical"||s=="high"||s=="medium") n++} END{printf "%d", n+0}' "${RENDER_TSV}" 2>/dev/null
+}
+
+_review_gate_low_rows() {
+  awk -F'\t' '{s=tolower($1); if (s=="low") n++} END{printf "%d", n+0}' "${RENDER_TSV}" 2>/dev/null
+}
+
+# Line 1 of review-gate.md: a reader who stops here still sees the verdict and
+# that remarks exist. Counts come from the reviewer's own REVIEW_FINDINGS header
+# (FINDINGS_*_TOTAL); "shown" from the render TSV — they can legitimately
+# disagree (R3) and the summary reports both rather than reconciling by fiat.
+gate_summary_line() {
+  local cap="${LEADV2_REVIEW_GATE_MAX_FINDINGS:-20}"
+  local reported=$(( FINDINGS_CRITICAL_TOTAL + FINDINGS_HIGH_TOTAL + FINDINGS_MEDIUM_TOTAL ))
+  local total=$(( reported + FINDINGS_LOW_TOTAL ))
+  local med_rows; med_rows="$(_review_gate_med_rows)"
+  if (( reported > 0 && med_rows == 0 )); then
+    printf '%s — %s finding(s): %s critical, %s high, %s medium, %s low; 0 shown — PARSE FAILURE, see review-%s.md' \
+      "${verdict}" "${total}" "${FINDINGS_CRITICAL_TOTAL}" "${FINDINGS_HIGH_TOTAL}" "${FINDINGS_MEDIUM_TOTAL}" "${FINDINGS_LOW_TOTAL}" "${reviewer_primary}"
+    return 0
+  fi
+  local shown="${med_rows}"
+  (( med_rows > cap )) && shown="${cap}"
+  printf '%s — %s finding(s): %s critical, %s high, %s medium, %s low; %s shown below' \
+    "${verdict}" "${total}" "${FINDINGS_CRITICAL_TOTAL}" "${FINDINGS_HIGH_TOTAL}" "${FINDINGS_MEDIUM_TOTAL}" "${FINDINGS_LOW_TOTAL}" "${shown}"
+}
+
+# The findings block. Pure stdout, no side effects, no exits. Severity floor
+# Medium; three filtered passes over the TSV (no sort — locale-unstable); cap
+# via LEADV2_REVIEW_GATE_MAX_FINDINGS with a mandatory, never-silent omission
+# notice naming review-findings.json.
+render_gate_findings() {
+  local cap="${LEADV2_REVIEW_GATE_MAX_FINDINGS:-20}"
+  local json_rel="docs/handoff/${TASK}/review-findings.json"
+  local reported=$(( FINDINGS_CRITICAL_TOTAL + FINDINGS_HIGH_TOTAL + FINDINGS_MEDIUM_TOTAL ))
+  local med_rows; med_rows="$(_review_gate_med_rows)"
+  local low_rows; low_rows="$(_review_gate_low_rows)"
+
+  # REVIEW-BODY-PERSIST-01 sibling hole: reviewer header says medium+ findings
+  # exist but zero FINDING: lines parsed. Must read as parse failure, never as
+  # "no findings".
+  if (( reported > 0 && med_rows == 0 )); then
+    printf 'findings_parse: failed\n'
+    _review_gate_by_arm_line
+    printf 'findings: PARSE_FAILURE — reviewer reported %s finding(s) at medium+ but 0 were\n' "${reported}"
+    printf '    machine-readable (no FINDING: lines). Read the full body: docs/handoff/%s/review-%s.md\n' "${TASK}" "${reviewer_primary}"
+    return 0
+  fi
+
+  _review_gate_by_arm_line
+  if (( med_rows == 0 && low_rows == 0 )); then
+    printf 'findings: none\n'
+    return 0
+  fi
+
+  printf 'findings:\n'
+  local want label shown=0 s f ln arm dim vv desc extra
+  for want in critical high medium; do
+    case "${want}" in
+      critical) label='Critical' ;;
+      high)     label='High' ;;
+      *)        label='Medium' ;;
+    esac
+    while IFS=$'\t' read -r s f ln arm dim vv desc; do
+      [[ -n "${s:-}" ]] || continue
+      (( shown >= cap )) && break
+      extra=""
+      [[ "${vv}" == "upheld" || "${vv}" == "refuted" ]] && extra=", verify=${vv}"
+      printf '  [%s] %s:%s (arm=%s, dim=%s%s) — %s\n' \
+        "${label}" "${f}" "${ln:-0}" "${arm}" "${dim}" "${extra}" "$(_review_gate_clip_desc "${desc}")"
+      shown=$((shown + 1))
+    done < <(awk -F'\t' -v w="${want}" 'tolower($1)==w' "${RENDER_TSV}" 2>/dev/null)
+  done
+  if (( med_rows > cap )); then
+    printf '  … %s more findings omitted (cap=%s) — full list: %s\n' "$((med_rows - cap))" "${cap}" "${json_rel}"
+  fi
+  if (( low_rows > 0 )); then
+    printf '  low: %s not shown — full list: %s\n' "${low_rows}" "${json_rel}"
+  fi
+}
+
