+ended_at: 2026-08-05T15:00:00Z
+reason:
+YREC
+printf 'alive' > "$LIVENESS_VERDICT_FILE"
+OUT="$(LIVENESS_VERDICT_FILE="$LIVENESS_VERDICT_FILE" \
+  LEADV2_PROJECT_ROOT="$TMP_ROOT" \
+  LEADV2_SS_LANE_LIVENESS_BIN="$STUB_LIVENESS" \
+  python3 - <<'PYEOF'
