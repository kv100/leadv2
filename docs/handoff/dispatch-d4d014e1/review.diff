+
+# Restore working stub
+cat > "$STUB_LIVENESS" <<STUBEOF
+#!/usr/bin/env bash
+VERDICT="\$(cat "${LIVENESS_VERDICT_FILE}" 2>/dev/null || echo alive)"
+printf '{"status": "%s"}\n' "\$VERDICT"
