n101\t \n102\t@@ -695,7 +702,14 @@ def main():\n103\t         \"2. Only an explicit stop/scope-change order pauses the task. \\\"Also do X\\\" = queue X in\\n\"\n104\t         \"   docs/leadv2/open-threads.md, do NOT switch to it.\\n\"\n105\t         \"3. PULSE MODE: no narration. Chat output is allowed ONLY at: Gate-1, an async question,\\n\"\n106\t-        \"   Phase-8 close. Everything else is silent tool work.\\n\"\n107\t+        \"   Phase-8 close, a [BROAD_STATUS] relay when the plugin emits BROAD_STATUS_READY\\n\"\n108\t+        \"   (paste founder-status.md verbatim; never compose one). Narration is\\n\"\n109\t+        \"   model-generated prose about its own work; the pulse is a verbatim relay of a\\n\"\n110\t+        \"   plugin-generated artifact — never a CronCreate job; the beat is plugin-owned.\\n\"\n111\t+        \"   Before relaying, compare the ready-line's at= stamp with the timestamp\\n\"\n112\t+        \"   leading line 1 of founder-status.md — if they differ, the file is from an\\n\"\n113\t+        \"   earlier beat: publish that fact, not the file.\\n\"\n114\t+        \"   Everything else is silent tool work.\\n\"\n115\t         \"4. Anything promised for later goes to docs/leadv2/scheduled-decisions.md the same turn.\"\n116\t     )\n117\t \n118\tdiff --git a/plugins/leadv2/scripts/leadv2-broad-status.sh b/plugins/leadv2/scripts/leadv2-broad-status.sh\n119\tindex 935b121..3a1b0cd 100755\n120\t--- a/plugins/leadv2/scripts/leadv2-broad-status.sh\n121\t+++ b/plugins/leadv2/scripts/leadv2-broad-status.sh\n122\t@@ -9,7 +9,15 @@\n123\t # A Haiku outage (or --model haiku failing) still yields a real table with\n124\t # no prose tail, never the old \"качество недоступно\" whole-status failure.\n125\t #\n126\t-# Rollback: LEADV2_SUPERVISE_BROAD_STATUS_S=0 disables the loop beat.\n127\t+# PULSE-IS-A-PLUGIN-DUTY-01 C1: delivery. The founder's watcher is\n128\t+# `tail -F | grep --line-buffered URGENT` on the loop log, and the\n129\t+# [BROAD_STATUS] block itself never contains that substring — before this\n130\t+# file emitted a ready-line, every beat was composed, timestamped, written to\n131\t+# two files, and woke nobody. See _emit_ready_line below.\n132\t+#\n133\t+# Rollback: LEADV2_SUPERVISE_BROAD_STATUS_S=0 disables the loop beat AND its\n134\t+# ready-line (the beat branch in leadv2-supervise-loop.sh is the only caller,\n135\t+# so the kill-switch cannot half-work).\n136\t \n137\t set -uo pipefail\n138\t \n139\t@@ -30,10 +38,88 @@ COLLECTOR_SH=\"${LEADV2_STATUS_COLLECTOR_BIN:-$SCRIPT_DIR/leadv2-status-collector\n140\t TASKS_LIB_SH=\"${LEADV2_TASKS_LIB_BIN:-$SCRIPT_DIR/leadv2-tasks-lib.sh}\"\n141\t CLAUDE_BIN=\"${LEADV2_BROAD_STATUS_CLAUDE_BIN:-claude}\"\n142\t \n143\t+# Beat identity (also the alarm-dedupe VALUE — semantic, never the rendered\n144\t+# line). LEADV2_BROAD_STATUS_BEAT_AT pins it for tests so a re-run of the\n145\t+# same beat is a true no-op, not a second wake.\n146\t+BEAT_AT=\"${LEADV2_BROAD_STATUS_BEAT_AT:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}\"\n147\t+# PULSE-IS-A-PLUGIN-DUTY-01 C2: stamped by the loop AFTER the backlog pump\n148\t+# ran and BEFORE this composer — \"dispatch before report\" as a code-enforced\n149\t+# order. \"unavailable\" when the pump could not run: never 0, which would\n150\t+# fabricate the fact that the pump ran and dispatched nothing.\n151\t+DISPATCHED=\"${LEADV2_BROAD_STATUS_DISPATCHED:-unavailable}\"\n152\t+\n153\t mkdir -p \"$(dirname \"$LOG_FILE\")\"\n154\t \n155\t+# ── C1: ONE URGENT-tagged ready-line per beat ──────────────────────────────\n156\t+# INVARIANT (R1): exactly ONE line per beat, and it is a POINTER to\n157\t+# founder-status.md — never the payload, never per-lane. Do not \"enrich\" it:\n158\t+# every extra line is a model wake paid on every remaining turn of the\n159\t+# attached session. Transition-deduped (key broad_status_ready, value = beat\n160\t+# identity) so a re-read or a double --ensure cannot fire the same beat\n161\t+# twice; lib absent → pass-through emit (R2) — this script runs once per\n162\t+# BROAD_STATUS_S window, not per poll, so pass-through is still one line per\n163\t+# beat.\n164\t+ALARM_LIB=\"${LEADV2_ALARM_DEDUPE_BIN:-${SCRIPT_DIR}/lib/leadv2-alarm-dedupe.sh}\"\n165\t+# shellcheck source=lib/leadv2-alarm-dedupe.sh\n166\t+[[ -f \"$ALARM_LIB\" ]] && source \"$ALARM_LIB\"\n167\t+_now_iso() { date -u +%Y-%m-%dT%H:%M:%SZ; }\n168\t+_emit_ready_line() {  # <rows|-> [degraded]\n169\t+  local rows=\"${1:--}\" degraded=\"${2:-}\"\n170\t+  local dedupe_value=\"$BEAT_AT${degraded:+ degraded}\"\n171\t+  if command -v leadv2_alarm_transition >/dev/null 2>&1 \\\n172\t+      && ! leadv2_alarm_transition broad_status_ready \"$dedupe_value\" 2>/dev/null; then\n173\t+    return 0  # same beat already delivered — suppressed\n174\t+  fi\n175\t+  local rel_path=\"${FOUNDER_STATUS_PATH#\"$PROJECT_ROOT\"/}\"\n176\t+  printf '%s [SUPERVISE-URGENT] BROAD_STATUS_READY at=%s path=%s rows=%s dispatched=%s%s\\n' \\\n177\t+    \"$(_now_iso)\" \"$BEAT_AT\" \"$rel_path\" \"$rows\" \"$DISPATCHED\" \\\n178\t+    \"${degraded:+ degraded=1}\" >>\"$LOG_FILE\"\n179\t+}\n180\t+\n181\t+# ── failed-beat artifact policy (PULSE-IS-A-PLUGIN-DUTY-01 fix r1) ──────────\n182\t+# A failed beat must never leave the PREVIOUS beat's healthy table in place\n183\t+# while claiming freshness: the ready-line points at founder-status.md, so\n184\t+# the artifact itself has to carry the failure. Replace it with an explicit\n185\t+# degraded block (same envelope, same content contract: one lane table + 2\n186\t+# prose lines, same atomic tmp+mv write as the happy path) and only then\n187\t+# signal READY degraded. If even that write fails, refuse READY entirely:\n188\t+# BROAD_STATUS_FAILED carries no path= token, so nothing points the founder\n189\t+# at the stale file, while the URGENT substring still wakes them (C1).\n190\t+_write_degraded_status() {  # <reason> -> rc 0 if the artifact was replaced\n191\t+  local reason=\"$1\" block\n192\t+  block=\"$(\n193\t+    printf '%s [BROAD_STATUS] dispatched=%s degraded=1\\n' \"$BEAT_AT\" \"$DISPATCHED\"\n194\t+    printf '| Линия | Что делает | Кто делает | Состояние | Уже на диске |\\n'\n195\t+    printf '|---|---|---|---|---|\\n'\n196\t+    printf '| (статус не собран) | — | — | %s | — |\\n\\n' \"$reason\"\n197\t+    printf 'СТАТУС НЕ СОБРАН на beat %s: %s.\\n' \"$BEAT_AT\" \"$reason\"\n198\t+    printf 'Таблица линий за этот beat недоступна — это НЕ значит, что линий нет.\\n'\n199\t+    printf '[BROAD_STATUS_END]\\n'\n200\t+  )\"\n201\t+  printf '%s\\n' \"$block\" >>\"$LOG_FILE\"\n202\t+  printf '%s\\n' \"$block\" >\"$FOUNDER_STATUS_PATH.tmp\" 2>/dev/null \\\n203\t+    && mv \"$FOUNDER_STATUS_PATH.tmp\" \"$FOUNDER_STATUS_PATH\" 2>/dev/null\n204\t+}\n205\t+_emit_fail_line() {  # <reason> — artifact NOT replaced: no READY, no path=\n206\t+  local reason=\"$1\"\n207\t+  local dedupe_value=\"$BEAT_AT failed\"\n208\t+  if command -v leadv2_alarm_transition >/dev/null 2>&1 \\\n209\t+      && ! leadv2_alarm_transition broad_status_ready \"$dedupe_value\" 2>/dev/null; then\n210\t+    return 0  # same beat already reported failed — suppressed\n211\t+  fi\n212\t+  printf '%s [SUPERVISE-URGENT] BROAD_STATUS_FAILED at=%s reason=%s stale_file_kept=1\\n' \\\n213\t+    \"$(_now_iso)\" \"$BEAT_AT\" \"$reason\" >>\"$LOG_FILE\"\n214\t+}\n215\t+\n216\t if ! bash \"$COLLECTOR_SH\" --project-root \"$PROJECT_ROOT\" --out \"$SNAPSHOT_PATH\" >/dev/null 2>&1; then\n217\t-  printf '%s [BROAD_STATUS] collection failure: quality read unavailable\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" >>\"$LOG_FILE\"\n218\t+  printf '%s [BROAD_STATUS] collection failure: quality read unavailable\\n' \"$(_now_iso)\" >>\"$LOG_FILE\"\n219\t+  # A beat that fails must still wake the lead (C1) — with the artifact\n220\t+  # REPLACED, so the relay can never publish the previous healthy table.\n221\t+  if _write_degraded_status \"сборщик статуса не ответил (collector failed)\"; then\n222\t+    _emit_ready_line \"-\" degraded\n223\t+  else\n224\t+    _emit_fail_line \"collection failure + founder-status.md not writable\"\n225\t+  fi\n226\t   exit 0\n227\t fi\n228\t \n229\t@@ -237,17 +323,25 @@ os.replace(tmp_prev, prev_path)\n230\t \n231\t out_path = os.path.join(tmpdir, \"render.json\")\n232\t with open(out_path, \"w\", encoding=\"utf-8\") as fh:\n233\t-    json.dump({\"table_md\": table_md, \"tail_facts\": tail_facts}, fh)\n234\t+    json.dump({\"table_md\": table_md, \"rows\": len(table_rows), \"tail_facts\": tail_facts}, fh)\n235\t print(out_path)\n236\t PY\n237\t )\"\n238\t RC=$?\n239\t if [[ $RC -ne 0 || -z \"$RENDER_JSON\" || ! -f \"$RENDER_JSON\" ]]; then\n240\t-  printf '%s [BROAD_STATUS] render failure: table unavailable\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" >>\"$LOG_FILE\"\n241\t+  printf '%s [BROAD_STATUS] render failure: table unavailable\\n' \"$(_now_iso)\" >>\"$LOG_FILE\"\n242\t+  # Same policy as the collector path: replace the artifact, then (and only\n243\t+  # then) wake; refuse READY entirely if the replacement itself failed.\n244\t+  if _write_degraded_status \"рендер таблицы не выполнен (render failed)\"; then\n245\t+    _emit_ready_line \"-\" degraded\n246\t+  else\n247\t+    _emit_fail_line \"render failure + founder-status.md not writable\"\n248\t+  fi\n249\t   exit 0\n250\t fi\n251\t \n252\t TABLE_MD=\"$(python3 -c \"import json,sys; print(json.load(open(sys.argv[1]))['table_md'])\" \"$RENDER_JSON\")\"\n253\t+ROWS_N=\"$(python3 -c \"import json,sys; print(json.load(open(sys.argv[1]))['rows'])\" \"$RENDER_JSON\")\"\n254\t TAIL_FACTS_JSON=\"$(python3 -c \"import json,sys; print(json.dumps(json.load(open(sys.argv[1]))['tail_facts'], ensure_ascii=False))\" \"$RENDER_JSON\")\"\n255\t \n256\t PROMPT=\"$(python3 - \"$TAIL_FACTS_JSON\" <<'PY'\n257\t@@ -275,10 +369,13 @@ if [[ -z \"$TAIL\" ]]; then\n258\t fi\n259\t \n260\t BLOCK=\"$(\n261\t-  printf '%s [BROAD_STATUS]\\n' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n262\t+  printf '%s [BROAD_STATUS] dispatched=%s\\n' \"$BEAT_AT\" \"$DISPATCHED\"\n263\t   printf '%s\\n\\n%s\\n' \"$TABLE_MD\" \"$TAIL\"\n264\t   printf '[BROAD_STATUS_END]\\n'\n265\t )\"\n266\t \n267\t printf '%s\\n' \"$BLOCK\" >>\"$LOG_FILE\"\n268\t printf '%s\\n' \"$BLOCK\" >\"$FOUNDER_STATUS_PATH.tmp\" && mv \"$FOUNDER_STATUS_PATH.tmp\" \"$FOUNDER_STATUS_PATH\"\n269\t+\n270\t+# C1 delivery: the ONE wake per beat, after both durable writes succeeded.\n271\t+_emit_ready_line \"$ROWS_N\"\n272\tdiff --git a/plugins/leadv2/scripts/leadv2-supervise-loop.sh b/plugins/leadv2/scripts/leadv2-supervise-loop.sh\n273\tindex caeb351..b29b3cc 100755\n274\t--- a/plugins/leadv2/scripts/leadv2-supervise-loop.sh\n275\t+++ b/plugins/leadv2/scripts/leadv2-supervise-loop.sh\n276\t@@ -153,7 +153,14 @@ _install_beat_cron() {\n277\t   [[ \"${LEADV2_SUPERVISE_BEAT_CRON:-1}\" == \"1\" ]] || return 0\n278\t   [[ -x \"$WATCHDOG_SH\" ]] || return 0\n279\t   local crontab_bin=\"${CRONTAB_BIN:-crontab}\"\n280\t-  command -v \"$crontab_bin\" >/dev/null 2>&1 || return 0\n281\t+  command -v \"$crontab_bin\" >/dev/null 2>&1 || {\n282\t+    # Visible gap, not a silent one (PULSE-IS-A-PLUGIN-DUTY-01 §3): with no\n283\t+    # cron there is no resurrection after a session death — only a manual\n284\t+    # --ensure restarts the loop, and the founder should see that in the log.\n285\t+    printf -- '%s [supervise-loop] beat-cron install skipped: %s unavailable — restart after a session death needs a manual --ensure\\n' \\\n286\t+      \"$(_now_iso)\" \"$crontab_bin\" >>\"$LOG_FILE\" 2>/dev/null || true\n287\t+    return 0\n288\t+  }\n289\t   # Repo slug for the marker (basename of the main repo toplevel).\n290\t   local repo_slug\n291\t   repo_slug=\"$(basename \"${PROJECT_ROOT}\")\"\n292\t@@ -374,9 +381,23 @@ except Exception:\n293\t }\n294\t trap _cleanup_sentinel EXIT\n295\t \n296\t-PUMP_SH=\"${SCRIPT_DIR}/leadv2-backlog-pump.sh\"\n297\t+PUMP_SH=\"${LEADV2_BACKLOG_PUMP_BIN:-${SCRIPT_DIR}/leadv2-backlog-pump.sh}\"\n298\t BROAD_STATUS_SH=\"${SCRIPT_DIR}/leadv2-broad-status.sh\"\n299\t \n300\t+# PULSE-IS-A-PLUGIN-DUTY-01 C1: a beat that cannot compose must still wake the\n301\t+# lead — a missing status is visible, never inferred from silence. Fires once\n302\t+# per occurrence (value carries the epoch), which at one beat per\n303\t+# BROAD_STATUS_S window is the same cadence the beat itself would have.\n304\t+_emit_broad_status_degraded() {  # <reason>\n305\t+  local reason=\"${1:-unknown}\"\n306\t+  if command -v leadv2_alarm_transition >/dev/null 2>&1 \\\n307\t+      && ! leadv2_alarm_transition broad_status_ready \"degraded:${reason}:$(date +%s)\" 2>/dev/null; then\n308\t+    return 0\n309\t+  fi\n310\t+  printf -- '%s [SUPERVISE-URGENT] BROAD_STATUS_READY at=%s path=docs/leadv2/founder-status.md rows=- dispatched=unavailable degraded=1 reason=%s\\n' \\\n311\t+    \"$(_now_iso)\" \"$reason\" >>\"$LOG_FILE\"\n312\t+}\n313\t+\n314\t # BACKLOG-PUMP-01: this loop already owns the sleep/poll cadence (off_limits:\n315\t # \"no sleep/poll loop owned by the LLM\") — the pump's refill trigger belongs\n316\t # here, not in the lead's turn. Gated by LEADV2_BACKLOG_PUMP so an explicit 0\n317\t@@ -811,14 +832,36 @@ while true; do\n318\t \n319\t   # The supervisor never reads or composes this status: the helper gathers\n320\t   # facts and makes one cheap model call, then writes a finished block here.\n321\t+  # PULSE-IS-A-PLUGIN-DUTY-01: (C2) the backlog pump runs BEFORE the composer\n322\t+  # and its dispatched count is exported into the beat, so \"a pulse dispatches\n323\t+  # before it reports\" is a code-enforced, after-the-fact auditable order —\n324\t+  # not an instruction. (C1) the composer emits one URGENT-tagged\n325\t+  # BROAD_STATUS_READY line per beat (the delivery contract); a beat that\n326\t+  # cannot compose still wakes via _emit_broad_status_degraded.\n327\t   if [[ \"$BROAD_STATUS_S\" =~ ^[0-9]+$ ]] && (( BROAD_STATUS_S > 0 )) \\\n328\t       && (( NOW_EPOCH - LAST_BROAD_STATUS_EPOCH >= BROAD_STATUS_S )); then\n329\t+    export LEADV2_BROAD_STATUS_DISPATCHED=\"unavailable\"\n330\t+    if [[ \"${LEADV2_BACKLOG_PUMP:-1}\" == \"1\" && -x \"$PUMP_SH\" ]]; then\n331\t+      _BS_PUMP_OUT=\"$(bash \"$PUMP_SH\" check 2>&1)\" || true\n332\t+      [[ -z \"$_BS_PUMP_OUT\" ]] || printf '%s\\n' \"$_BS_PUMP_OUT\" >>\"$LOG_FILE\"\n333\t+      # Parse the pump's own \"check complete:\" summary; absent summary →\n334\t+      # \"unavailable\", never 0 (a fabricated \"ran and dispatched nothing\").\n335\t+      export LEADV2_BROAD_STATUS_DISPATCHED=\"$(printf '%s\\n' \"$_BS_PUMP_OUT\" \\\n336\t+        | sed -n 's/.*check complete:.*dispatched=\\([0-9][0-9]*\\).*/\\1/p' | tail -n1)\"\n337\t+      [[ -n \"${LEADV2_BROAD_STATUS_DISPATCHED}\" ]] || export LEADV2_BROAD_STATUS_DISPATCHED=\"unavailable\"\n338\t+    fi\n339\t     if [[ -x \"$BROAD_STATUS_SH\" ]]; then\n340\t-      bash \"$BROAD_STATUS_SH\" >>\"$LOG_FILE\" 2>&1 || \\\n341\t+      if bash \"$BROAD_STATUS_SH\" >>\"$LOG_FILE\" 2>&1; then\n342\t+        :\n343\t+      else\n344\t         printf -- '%s [BROAD_STATUS] failure: quality read unavailable\\n' \"$(_now_iso)\" >>\"$LOG_FILE\"\n345\t+        _emit_broad_status_degraded \"composer_rc_nonzero\"\n346\t+      fi\n347\t     else\n348\t       printf -- '%s [BROAD_STATUS] failure: composer unavailable; quality read unavailable\\n' \"$(_now_iso)\" >>\"$LOG_FILE\"\n349\t+      _emit_broad_status_degraded \"composer_missing\"\n350\t     fi\n351\t+    unset LEADV2_BROAD_STATUS_DISPATCHED\n352\t     LAST_BROAD_STATUS_EPOCH=$NOW_EPOCH\n353\t   fi\n354\t \n355\tdiff --git a/plugins/leadv2/scripts/tests/test-broad-status-duty.sh b/plugins/leadv2/scripts/tests/test-broad-status-duty.sh\n356\tnew file mode 100755\n357\tindex 0000000..bdff660\n358\t--- /dev/null\n359\t+++ b/plugins/leadv2/scripts/tests/test-broad-status-duty.sh\n360\t@@ -0,0 +1,402 @@\n361\t+#!/usr/bin/env bash\n362\t+# tests/test-broad-status-duty.sh — PULSE-IS-A-PLUGIN-DUTY-01.\n363\t+#\n364\t+# The transition this suite exists to survive: the beat was composed,\n365\t+# timestamped, and written to two files — but contained no URGENT substring,\n366\t+# so the founder's `grep --line-buffered URGENT` watcher filtered it out and\n367\t+# no live session was ever woken. Cases:\n368\t+#\n369\t+#   1. one beat -> exactly ONE [SUPERVISE-URGENT] BROAD_STATUS_READY line\n370\t+#      that passes the REAL filter (grep URGENT), and founder-status.md\n371\t+#      carries the dispatched= stamp (C1+C2).\n372\t+#   2. dedupe: same beat identity re-run -> still one line; new identity ->\n373\t+#      fires; lib force-disabled -> pass-through still one line per run (R2).\n374\t+#   3. ordering: full loop, one cycle -> pump ran BEFORE the composer wrote\n375\t+#      founder-status.md, and the ready-line's dispatched= matches the pump.\n376\t+#   4. session-death survival (the demonstration, not a claim): kill the\n377\t+#      loop, age past 2xPULSE_S, run the watchdog -> LOOP_SILENT, a NEW live\n378\t+#      pid, and a fresh beat afterwards. Includes the --ensure adopt\n379\t+#      assertion (R3: single-owner sentinel, no sibling on double-ensure).\n380\t+#   5. degraded beat: collector missing -> BROAD_STATUS_READY degraded=1\n381\t+#      still appears (a missing status is visible, never silent).\n382\t+#   9. failed beat is visibly failed IN THE ARTIFACT (fix r1): collector or\n383\t+#      renderer failure REPLACES founder-status.md (sentinel gone, СТАТУС НЕ\n384\t+#      СОБРАН, pinned beat, degraded=1 on line 1); ready-line at= always\n385\t+#      equals the file's line-1 timestamp; unwritable artifact -> READY is\n386\t+#      refused (BROAD_STATUS_FAILED stale_file_kept=1, stale bytes kept).\n387\t+#   6. kill-switch: LEADV2_SUPERVISE_BROAD_STATUS_S=0 -> no beat, no\n388\t+#      ready-line (the rollback cannot half-work).\n389\t+#   7. crontab unavailable -> the skip is LOGGED, not silent.\n390\t+#   8. wording drift (R4): the relay sentence is present verbatim in every\n391\t+#      C3 surface, and the CronCreate ban lives where a non-supervisor lead\n392\t+#      reads it (C4).\n393\t+#\n394\t+# Hermetic: LEADV2_PROJECT_ROOT/LEADV2_STATE_ROOT point at throwaway dirs,\n395\t+# CRONTAB_BIN is a stub (the real crontab is never touched), the composer's\n396\t+# claude call is a stub (no model invoked), the pump is a stub.\n397\t+# Non-goals: real crontab, real reboot, real claude.\n398\t+#\n399\t+# NOTE on timing: one supervise.sh snapshot costs ~25s in a bare fixture\n400\t+# (liveness/pick retries against an empty control plane), so loop-running\n401\t+# cases use generous timeouts — a cycle completes in ~60s, not ~5s.\n402\t+# Run: bash scripts/tests/test-broad-status-duty.sh\n403\t+\n404\t+set -uo pipefail\n405\t+\n406\t+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n407\t+PLUGIN_DIR=\"$(cd \"${SCRIPT_DIR}/..\" && pwd)\"   # plugins/leadv2\n408\t+source \"${SCRIPT_DIR}/leadv2-temp.sh\"\n409\t+\n410\t+LOOP_SH=\"${SCRIPT_DIR}/leadv2-supervise-loop.sh\"\n411\t+BROAD_STATUS_SH=\"${SCRIPT_DIR}/leadv2-broad-status.sh\"\n412\t+WATCHDOG_SH=\"${SCRIPT_DIR}/leadv2-supervise-watchdog.sh\"\n413\t+STATE_PATH_SH=\"${SCRIPT_DIR}/leadv2-state-path.sh\"\n414\t+\n415\t+PASS=0; FAIL=0; ERRORS=()\n416\t+log()  { printf -- '[TEST] %s\\n' \"$*\"; }\n417\t+pass() { PASS=$(( PASS + 1 )); log \"PASS: $1\"; }\n418\t+fail() { FAIL=$(( FAIL + 1 )); ERRORS+=(\"FAIL: $1\"); log \"FAIL: $1\"; }\n419\t+\n420\t+TMP=\"$(lv2_mktemp_dir broad-status-duty)\"\n421\t+REPO=\"$TMP/proj\"\n422\t+STATE=\"$TMP/state\"\n423\t+STUBS=\"$TMP/stubs\"\n424\t+PUMP_COUNTER=\"$TMP/pump-counter\"\n425\t+CRONTAB_STUB_STATE=\"$TMP/crontab-state\"\n426\t+mkdir -p \"$REPO\" \"$STATE\" \"$STUBS\"\n427\t+git -C \"$REPO\" init -q\n428\t+# TEST SAFETY: this suite writes through leadv2-state-path.sh — prove the\n429\t+# fixture is a throwaway before any control-plane write happens.\n430\t+lv2_assert_scratch_repo \"$REPO\"\n431\t+\n432\t+export LEADV2_PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\"\n433\t+\n434\t+LOG_FILE=\"$(PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" bash \"$STATE_PATH_SH\" supervise-loop.log)\"\n435\t+FOUNDER_STATUS=\"$REPO/docs/leadv2/founder-status.md\"\n436\t+ready_count()   { grep -c 'BROAD_STATUS_READY' \"$LOG_FILE\" 2>/dev/null || true; }\n437\t+urgent_count()  { grep 'URGENT' \"$LOG_FILE\" 2>/dev/null | grep -c 'BROAD_STATUS_READY' || true; }\n438\t+started_pids()  { sed -n 's/.*\\[supervise-loop\\] started pid=\\([0-9]*\\) .*/\\1/p' \"$LOG_FILE\" 2>/dev/null; }\n439\t+\n440\t+# ── stubs ──────────────────────────────────────────────────────────────────\n441\t+cat >\"$STUBS/collector.sh\" <<'EOF'\n442\t+#!/usr/bin/env bash\n443\t+# Minimal snapshot: no lanes, no repo_facts — enough for the deterministic\n444\t+# renderer to produce the placeholder table.\n445\t+out=\"\"\n446\t+while [[ $# -gt 0 ]]; do\n447\t+  case \"$1\" in\n448\t+    --out) out=\"$2\"; shift 2 ;;\n449\t+    *) shift ;;\n450\t+  esac\n451\t+done\n452\t+[[ -z \"$out\" ]] && exit 1\n453\t+printf '{\"sections\": {}}' >\"$out\"\n454\t+EOF\n455\t+cat >\"$STUBS/claude.sh\" <<'EOF'\n456\t+#!/usr/bin/env bash\n457\t+# Fixed composer result — no model is called from this suite.\n458\t+printf '{\"result\":\"тестовый хвост: очередь пуста, ничего не приземлилось.\"}'\n459\t+EOF\n460\t+cat >\"$STUBS/pump.sh\" <<EOF\n461\t+#!/usr/bin/env bash\n462\t+# Stub pump: increments a counter on every check (mtime = last run) and logs\n463\t+# the same \"check complete:\" summary line the real pump emits.\n464\t+if [[ \"\\${1:-}\" == \"check\" ]]; then\n465\t+  n=0\n466\t+  [[ -f \"\\$PUMP_COUNTER\" ]] && n=\"\\$(cat \"\\$PUMP_COUNTER\" 2>/dev/null || echo 0)\"\n467\t+  echo \\$((n + 1)) >\"\\$PUMP_COUNTER\"\n468\t+  echo \"check complete: examined=1 dispatched=2 live=0 remaining_capacity=5 below_floor=0\" >&2\n469\t+fi\n470\t+exit 0\n471\t+EOF\n472\t+cat >\"$STUBS/crontab.sh\" <<EOF\n473\t+#!/usr/bin/env bash\n474\t+# Stub crontab: records installs into a state file, never touches the real one.\n475\t+case \"\\${1:-}\" in\n476\t+  -l) cat \"\\$CRONTAB_STUB_STATE\" 2>/dev/null; exit 0 ;;\n477\t+  -)  cat >\"\\$CRONTAB_STUB_STATE\"; exit 0 ;;\n478\t+esac\n479\t+exit 0\n480\t+EOF\n481\t+chmod +x \"$STUBS/collector.sh\" \"$STUBS/claude.sh\" \"$STUBS/pump.sh\" \"$STUBS/crontab.sh\"\n482\t+\n483\t+# Common env for every direct broad-status invocation.\n484\t+beat_env() {  # <beat-at> [extra env assignments via caller]\n485\t+  env LEADV2_PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" \\\n486\t+    LEADV2_STATUS_COLLECTOR_BIN=\"$STUBS/collector.sh\" \\\n487\t+    LEADV2_BROAD_STATUS_CLAUDE_BIN=\"$STUBS/claude.sh\" \\\n488\t+    LEADV2_BROAD_STATUS_BEAT_AT=\"$1\" \\\n489\t+    LEADV2_BROAD_STATUS_DISPATCHED=\"2\" \\\n490\t+    \"${@:2}\"\n491\t+}\n492\t+loop_env() {  # extra env assignments\n493\t+  env LEADV2_PROJECT_ROOT=\"$REPO\" CLAUDE_PROJECT_DIR=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" \\\n494\t+    LEADV2_STATUS_COLLECTOR_BIN=\"$STUBS/collector.sh\" \\\n495\t+    LEADV2_BROAD_STATUS_CLAUDE_BIN=\"$STUBS/claude.sh\" \\\n496\t+    LEADV2_BACKLOG_PUMP_BIN=\"$STUBS/pump.sh\" \\\n497\t+    CRONTAB_BIN=\"$STUBS/crontab.sh\" \\\n498\t+    \"$@\"\n499\t+}\n500\t+wait_for() {  # <desc> <timeout_s> <cmd...> — poll until cmd succeeds\n501\t+  local desc=\"$1\" tmo=\"$2\"; shift 2\n502\t+  local i=0\n503\t+  while (( i < tmo )); do\n504\t+    if \"$@\" >/dev/null 2>&1; then return 0; fi\n505\t+    sleep 1; i=$(( i + 1 ))\n506\t+  done\n507\t+  fail \"$desc (waited ${tmo}s)\"\n508\t+  return 1\n509\t+}\n510\t+\n511\t+cleanup() {\n512\t+  # Kill any loop this suite left behind (sentinel pid), then drop the tree.\n513\t+  local sent pid\n514\t+  sent=\"$(PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" bash \"$STATE_PATH_SH\" .supervise-loop.json 2>/dev/null || true)\"\n515\t+  if [[ -n \"$sent\" && -f \"$sent\" ]]; then\n516\t+    pid=\"$(python3 -c \"import json;print(json.load(open('$sent')).get('pid',0))\" 2>/dev/null || echo 0)\"\n517\t+    [[ \"$pid\" -gt 0 ]] && kill \"$pid\" 2>/dev/null || true\n518\t+  fi\n519\t+  rm -rf \"$TMP\"\n520\t+}\n521\t+trap cleanup EXIT\n522\t+\n523\t+# ── Test 1: ready-line emitted, passes the real filter, artifact written ───\n524\t+beat_env \"2026-08-16T10:00:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n525\t+if [[ -f \"$FOUNDER_STATUS\" ]]; then pass \"T1a: founder-status.md written\"; else fail \"T1a: founder-status.md missing\"; fi\n526\t+if [[ \"$(urgent_count)\" == \"1\" ]]; then pass \"T1b: exactly one URGENT-filtered BROAD_STATUS_READY line\"; else fail \"T1b: expected 1 URGENT BROAD_STATUS_READY line, got $(urgent_count)\"; fi\n527\t+if grep -q 'BROAD_STATUS_READY at=2026-08-16T10:00:00Z path=docs/leadv2/founder-status.md rows=0 dispatched=2$' \"$LOG_FILE\"; then\n528\t+  pass \"T1c: ready-line carries at/path/rows/dispatched\"\n529\t+else\n530\t+  fail \"T1c: ready-line shape wrong: $(grep BROAD_STATUS_READY \"$LOG_FILE\" | tail -1)\"\n531\t+fi\n532\t+if grep -q '\\[BROAD_STATUS\\] dispatched=2$' \"$LOG_FILE\" && grep -q 'dispatched=2' \"$FOUNDER_STATUS\"; then\n533\t+  pass \"T1d: block header + artifact carry the dispatched= stamp\"\n534\t+else\n535\t+  fail \"T1d: dispatched= stamp missing from block/artifact\"\n536\t+fi\n537\t+\n538\t+# ── Test 2: dedupe (same beat suppressed, new beat fires, lib-less R2) ─────\n539\t+beat_env \"2026-08-16T10:00:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n540\t+if [[ \"$(ready_count)\" == \"1\" ]]; then pass \"T2a: same beat re-run -> still one line\"; else fail \"T2a: dedupe failed, $(ready_count) lines\"; fi\n541\t+beat_env \"2026-08-16T10:30:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n542\t+if [[ \"$(ready_count)\" == \"2\" ]]; then pass \"T2b: new beat -> fires\"; else fail \"T2b: expected 2 lines, got $(ready_count)\"; fi\n543\t+beat_env \"2026-08-16T11:00:00Z\" LEADV2_ALARM_DEDUPE_BIN=/nonexistent-lib \\\n544\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n545\t+if [[ \"$(ready_count)\" == \"3\" ]]; then pass \"T2c: lib absent -> pass-through still one line per beat (R2)\"; else fail \"T2c: expected 3 lines, got $(ready_count)\"; fi\n546\t+\n547\t+# ── Test 3: dispatch before report, through the real loop branch ───────────\n548\t+: >\"$LOG_FILE\"; : >\"$PUMP_COUNTER\" 2>/dev/null || true; rm -f \"$PUMP_COUNTER\" \"$FOUNDER_STATUS\"\n549\t+timeout 90 loop_env \\\n550\t+  LEADV2_SUPERVISE_LOOP_MAX_CYCLES=1 LEADV2_SUPERVISE_LOOP_PULSE_ON_START=1 \\\n551\t+  LEADV2_SUPERVISE_EVENT_POLL_S=0 \\\n552\t+  bash \"$LOOP_SH\" >/dev/null 2>&1 || true\n553\t+if [[ -f \"$PUMP_COUNTER\" && -f \"$FOUNDER_STATUS\" ]]; then\n554\t+  ORDER=\"$(python3 -c \"\n555\t+import os, sys\n556\t+pump, status = os.path.getmtime('$PUMP_COUNTER'), os.path.getmtime('$FOUNDER_STATUS')\n557\t+print('before' if pump < status else 'after')\n558\t+\")\"\n559\t+  if [[ \"$ORDER\" == \"before\" ]]; then pass \"T3a: pump ran before founder-status.md was written\"; else fail \"T3a: pump ran AFTER the composer\"; fi\n560\t+else\n561\t+  fail \"T3a: pump counter or founder-status.md missing after one loop cycle\"\n562\t+fi\n563\t+if grep -q 'BROAD_STATUS_READY at=.* path=docs/leadv2/founder-status.md rows=0 dispatched=2' \"$LOG_FILE\"; then\n564\t+  pass \"T3b: loop-run beat stamps the pump's dispatched count\"\n565\t+else\n566\t+  fail \"T3b: no ready-line with dispatched=2 after loop cycle: $(grep BROAD_STATUS_READY \"$LOG_FILE\" || echo none)\"\n567\t+fi\n568\t+\n569\t+# ── Test 4: session-death survival — the demonstration ─────────────────────\n570\t+: >\"$LOG_FILE\"; rm -f \"$PUMP_COUNTER\" \"$FOUNDER_STATUS\"\n571\t+timeout 240 loop_env \\\n572\t+  LEADV2_SUPERVISE_LOOP_PULSE_ON_START=1 LEADV2_SUPERVISE_EVENT_POLL_S=1 \\\n573\t+  LEADV2_SUPERVISE_PULSE_S=2 LEADV2_SUPERVISE_BROAD_STATUS_S=2 \\\n574\t+  bash \"$LOOP_SH\" >/dev/null 2>&1 &\n575\t+T4_LOOP_SHELL=$!\n576\t+wait_for \"T4a: first beat appears\" 120 bash -c \"grep -q BROAD_STATUS_READY '$LOG_FILE'\"\n577\t+OLD_PID=\"$(started_pids | tail -n1)\"\n578\t+# R3: a second --ensure while the loop is live must ADOPT, never spawn.\n579\t+STARTED_BEFORE=\"$(started_pids | grep -c . || true)\"\n580\t+timeout 20 loop_env bash \"$LOOP_SH\" --ensure >/dev/null 2>&1 || true\n581\t+if grep -q 'adopt existing loop pid=' \"$LOG_FILE\" && [[ \"$(started_pids | grep -c . || true)\" == \"$STARTED_BEFORE\" ]]; then\n582\t+  pass \"T4b: double --ensure adopts (no sibling loop, R3)\"\n583\t+else\n584\t+  fail \"T4b: --ensure did not cleanly adopt the live loop\"\n585\t+fi\n586\t+kill \"$OLD_PID\" 2>/dev/null || true\n587\t+sleep 5   # heartbeat ages past 2xPULSE_S=4s AND the pid is dead\n588\t+timeout 240 loop_env LEADV2_SUPERVISE_PULSE_S=2 bash \"$WATCHDOG_SH\" --project-root \"$REPO\" >/dev/null 2>&1 &\n589\t+T4_WD=$!\n590\t+wait_for \"T4c: LOOP_SILENT alarm\" 60 bash -c \"grep -q 'LOOP_SILENT' '$LOG_FILE'\"\n591\t+wait_for \"T4d: replacement loop started\" 90 bash -c \"[[ \\\"\\$(started_pids | tail -n1)\\\" != \\\"$OLD_PID\\\" && -n \\\"\\$(started_pids | tail -n1)\\\" ]]\"\n592\t+NEW_PID=\"$(started_pids | tail -n1)\"\n593\t+wait_for \"T4e: fresh beat from the replacement loop\" 150 bash -c \"[[ \\\"\\$(grep -c BROAD_STATUS_READY '$LOG_FILE')\\\" -ge 2 ]]\"\n594\t+if kill -0 \"$NEW_PID\" 2>/dev/null; then pass \"T4f: replacement loop pid=$NEW_PID is alive (old=$OLD_PID)\"; else fail \"T4f: replacement loop not alive\"; fi\n595\t+kill \"$T4_WD\" \"$NEW_PID\" 2>/dev/null || true\n596\t+wait \"$T4_WD\" 2>/dev/null || true\n597\t+\n598\t+# ── Test 5: degraded beat is visible ───────────────────────────────────────\n599\t+: >\"$LOG_FILE\"\n600\t+env LEADV2_PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" \\\n601\t+  LEADV2_STATUS_COLLECTOR_BIN=/nonexistent-collector \\\n602\t+  LEADV2_BROAD_STATUS_BEAT_AT=\"2026-08-16T12:00:00Z\" \\\n603\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n604\t+if grep -q 'BROAD_STATUS_READY at=.* degraded=1$' \"$LOG_FILE\"; then\n605\t+  pass \"T5: collector failure -> degraded ready-line still wakes\"\n606\t+else\n607\t+  fail \"T5: no degraded=1 ready-line: $(cat \"$LOG_FILE\")\"\n608\t+fi\n609\t+\n610\t+# ── Test 9: a failed beat is visibly failed in the ARTIFACT (fix r1) ───────\n611\t+# T5 asserts the degraded ready-line — the test that passed while the bug was\n612\t+# live. T9 asserts on what the relay would PUBLISH: the artifact bytes.\n613\t+mkdir -p \"$REPO/docs/leadv2\"\n614\t+seed_stale_status() {\n615\t+  printf '2026-08-16T00:00:00Z [BROAD_STATUS] dispatched=0\\n' >\"$FOUNDER_STATUS\"\n616\t+  printf '| Линия | Что делает | Кто делает | Состояние | Уже на диске |\\n' >>\"$FOUNDER_STATUS\"\n617\t+  printf '|---|---|---|---|---|\\n' >>\"$FOUNDER_STATUS\"\n618\t+  printf '| HEALTHY-SENTINEL-DO-NOT-KEEP | всё хорошо | — | тихо 5 мин | — |\\n\\n' >>\"$FOUNDER_STATUS\"\n619\t+  printf 'Всё отлично, ничего не происходит.\\n[BROAD_STATUS_END]\\n' >>\"$FOUNDER_STATUS\"\n620\t+}\n621\t+degraded_assertions() {  # <label> <pinned-beat> <reason-substring>\n622\t+  local label=\"$1\" beat=\"$2\" reason_re=\"$3\"\n623\t+  if grep -q 'HEALTHY-SENTINEL-DO-NOT-KEEP' \"$FOUNDER_STATUS\"; then\n624\t+    fail \"$label: previous healthy table still in founder-status.md\"\n625\t+  else pass \"$label: previous healthy table replaced\"; fi\n626\t+  if grep -q 'СТАТУС НЕ СОБРАН' \"$FOUNDER_STATUS\"; then\n627\t+    pass \"$label: explicit СТАТУС НЕ СОБРАН sentence present\"\n628\t+  else fail \"$label: no СТАТУС НЕ СОБРАН sentence\"; fi\n629\t+  if grep -q \"$beat\" \"$FOUNDER_STATUS\"; then\n630\t+    pass \"$label: pinned beat timestamp present\"\n631\t+  else fail \"$label: pinned beat timestamp missing\"; fi\n632\t+  if head -n1 \"$FOUNDER_STATUS\" | grep -q 'degraded=1'; then\n633\t+    pass \"$label: line 1 carries degraded=1\"\n634\t+  else fail \"$label: line 1 lacks degraded=1: $(head -n1 \"$FOUNDER_STATUS\")\"; fi\n635\t+  if grep -q \"$reason_re\" \"$FOUNDER_STATUS\"; then\n636\t+    pass \"$label: Состояние cell names the failure ($reason_re)\"\n637\t+  else fail \"$label: failure reason missing from the table row\"; fi\n638\t+}\n639\t+\n640\t+# T9a: collector failure replaces the artifact.\n641\t+seed_stale_status; : >\"$LOG_FILE\"\n642\t+beat_env \"2026-08-16T12:30:00Z\" LEADV2_STATUS_COLLECTOR_BIN=/bin/false \\\n643\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n644\t+degraded_assertions \"T9a\" \"2026-08-16T12:30:00Z\" 'collector failed'\n645\t+\n646\t+# T9b: render failure (invalid JSON snapshot) replaces the artifact — the\n647\t+# failure path the review did not name.\n648\t+cat >\"$STUBS/bad-collector.sh\" <<'EOF'\n649\t+#!/usr/bin/env bash\n650\t+# Writes a snapshot that is NOT valid JSON -> the deterministic render fails.\n651\t+out=\"\"\n652\t+while [[ $# -gt 0 ]]; do\n653\t+  case \"$1\" in\n654\t+    --out) out=\"$2\"; shift 2 ;;\n655\t+    *) shift ;;\n656\t+  esac\n657\t+done\n658\t+[[ -z \"$out\" ]] && exit 1\n659\t+printf 'this-is-not-json' >\"$out\"\n660\t+EOF\n661\t+chmod +x \"$STUBS/bad-collector.sh\"\n662\t+seed_stale_status; : >\"$LOG_FILE\"\n663\t+beat_env \"2026-08-16T13:00:00Z\" LEADV2_STATUS_COLLECTOR_BIN=\"$STUBS/bad-collector.sh\" \\\n664\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n665\t+degraded_assertions \"T9b\" \"2026-08-16T13:00:00Z\" 'render failed'\n666\t+\n667\t+# T9c: stamp coherence (P2) — the ready-line's at= always equals the leading\n668\t+# timestamp of founder-status.md line 1, healthy beat AND degraded beat, so a\n669\t+# reader can detect staleness without trusting the writer.\n670\t+stamp_coherence_check() {  # <label>\n671\t+  local label=\"$1\" at_val line1_ts\n672\t+  at_val=\"$(sed -n 's/.*BROAD_STATUS_READY at=\\([^ ]*\\).*/\\1/p' \"$LOG_FILE\" | tail -n1)\"\n673\t+  line1_ts=\"$(head -n1 \"$FOUNDER_STATUS\" | awk '{print $1}')\"\n674\t+  if [[ -n \"$at_val\" && \"$at_val\" == \"$line1_ts\" ]]; then\n675\t+    pass \"$label: ready-line at= == founder-status.md line-1 timestamp\"\n676\t+  else\n677\t+    fail \"$label: stamp mismatch: ready at=$at_val file line1=$line1_ts\"\n678\t+  fi\n679\t+}\n680\t+seed_stale_status; : >\"$LOG_FILE\"\n681\t+beat_env \"2026-08-16T13:30:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n682\t+stamp_coherence_check \"T9c-healthy\"\n683\t+beat_env \"2026-08-16T14:00:00Z\" LEADV2_STATUS_COLLECTOR_BIN=/bin/false \\\n684\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n685\t+stamp_coherence_check \"T9c-degraded\"\n686\t+\n687\t+# T9d: artifact unwritable -> READY refused, stale file kept byte-identical.\n688\t+if [[ \"${EUID:-$(id -u)}\" -eq 0 ]]; then\n689\t+  log \"SKIP: T9d (running as root — chmod 500 does not block writes)\"\n690\t+else\n691\t+  RO_DIR=\"$TMP/ro-status\"; mkdir -p \"$RO_DIR\"\n692\t+  printf 'STALE-BYTES-KEEP\\n' >\"$RO_DIR/founder-status.md\"\n693\t+  STALE_COPY=\"$TMP/t9d-stale-copy\"; cp \"$RO_DIR/founder-status.md\" \"$STALE_COPY\"\n694\t+  chmod 500 \"$RO_DIR\"\n695\t+  : >\"$LOG_FILE\"\n696\t+  beat_env \"2026-08-16T14:30:00Z\" LEADV2_FOUNDER_STATUS_PATH=\"$RO_DIR/founder-status.md\" \\\n697\t+    LEADV2_STATUS_COLLECTOR_BIN=/bin/false bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n698\t+  chmod 700 \"$RO_DIR\"   # restore mode BEFORE suite teardown (fixture-leak risk)\n699\t+  if [[ \"$(ready_count)\" == \"0\" ]]; then\n700\t+    pass \"T9d: unwritable artifact -> zero BROAD_STATUS_READY lines\"\n701\t+  else\n702\t+    fail \"T9d: READY advertised a file it could not write ($(ready_count) lines)\"\n703\t+  fi\n704\t+  t9d_failed=\"$(grep -c 'BROAD_STATUS_FAILED .*stale_file_kept=1' \"$LOG_FILE\" 2>/dev/null || true)\"\n705\t+  if [[ \"$t9d_failed\" == \"1\" ]]; then\n706\t+    pass \"T9d: exactly one BROAD_STATUS_FAILED stale_file_kept=1\"\n707\t+  else\n708\t+    fail \"T9d: expected 1 BROAD_STATUS_FAILED line, got $t9d_failed: $(grep BROAD_STATUS_FAILED \"$LOG_FILE\" || echo none)\"\n709\t+  fi\n710\t+  if cmp -s \"$RO_DIR/founder-status.md\" \"$STALE_COPY\"; then\n711\t+    pass \"T9d: stale file byte-identical (nothing half-wrote it)\"\n712\t+  else\n713\t+    fail \"T9d: stale file was modified despite the unwritable dir\"\n714\t+  fi\n715\t+fi\n716\t+\n717\t+# ── Test 6: kill-switch disables beat AND ready-line ────────────────────────\n718\t+: >\"$LOG_FILE\"; rm -f \"$FOUNDER_STATUS\"\n719\t+timeout 40 loop_env \\\n720\t+  LEADV2_SUPERVISE_LOOP_MAX_CYCLES=1 LEADV2_SUPERVISE_LOOP_PULSE_ON_START=1 \\\n721\t+  LEADV2_SUPERVISE_EVENT_POLL_S=0 LEADV2_SUPERVISE_BROAD_STATUS_S=0 \\\n722\t+  bash \"$LOOP_SH\" >/dev/null 2>&1 || true\n723\t+if [[ \"$(ready_count)\" == \"0\" && ! -f \"$FOUNDER_STATUS\" ]]; then\n724\t+  pass \"T6: BROAD_STATUS_S=0 -> no beat, no ready-line (rollback whole)\"\n725\t+else\n726\t+  fail \"T6: kill-switch half-works (ready lines: $(ready_count))\"\n727\t+fi\n728\t+\n729\t+# ── Test 7: crontab unavailable -> skip is logged ──────────────────────────\n730\t+: >\"$LOG_FILE\"\n731\t+timeout 40 loop_env CRONTAB_BIN=/nonexistent-crontab \\\n732\t+  LEADV2_SUPERVISE_LOOP_MAX_CYCLES=1 LEADV2_SUPERVISE_LOOP_PULSE_ON_START=1 \\\n733\t+  LEADV2_SUPERVISE_EVENT_POLL_S=0 \\\n734\t+  bash \"$LOOP_SH\" >/dev/null 2>&1 || true\n735\t+if grep -q 'beat-cron install skipped: .* unavailable' \"$LOG_FILE\"; then\n736\t+  pass \"T7: cron-install skip is logged, gap visible\"\n737\t+else\n738\t+  fail \"T7: skip not logged: $(grep -i cron \"$LOG_FILE\" || echo none)\"\n739\t+fi\n740\t+\n741\t+# ── Test 8: wording drift across the C3/C4 surfaces (R4) ───────────────────\n742\t+ANCHOR=\"$PLUGIN_DIR/hooks/leadv2-task-anchor.sh\"\n743\t+n=\"$(grep -c 'BROAD_STATUS_READY' \"$ANCHOR\" || true)\"\n744\t+if [[ \"$n\" -eq 2 ]]; then pass \"T8a: anchor DIRECTIVE lists the relay in BOTH blocks\"; else fail \"T8a: anchor has $n BROAD_STATUS_READY mentions (expected 2)\"; fi\n745\t+for f in \"$PLUGIN_DIR/commands/leadv2.md\" \"$PLUGIN_DIR/hooks/leadv2-supervisor-mode-reinject.sh\" \"$PLUGIN_DIR/docs/supervisor-role.md\"; do\n746\t+  if grep -q 'BROAD_STATUS_READY' \"$f\" && grep -q 'verbatim relay of a' \"$f\"; then\n747\t+    pass \"T8b: $(basename \"$f\") carries the relay contract\"\n748\t+  else\n749\t+    fail \"T8b: $(basename \"$f\") drifted from the relay wording\"\n750\t+  fi\n751\t+done\n752\t+for f in \"$ANCHOR\" \"$PLUGIN_DIR/commands/leadv2.md\"; do\n753\t+  if grep -q 'CronCreate' \"$f\"; then pass \"T8c: CronCreate ban present in $(basename \"$f\") (C4)\"; else fail \"T8c: CronCreate ban missing from $(basename \"$f\")\"; fi\n754\t+done\n755\t+\n756\t+log \"\"\n757\t+log \"=== ${PASS} passed, ${FAIL} failed ===\"\n758\t+if [[ \"$FAIL\" -gt 0 ]]; then\n759\t+  printf -- '%s\\n' \"${ERRORS[@]:-}\" >&2\n760\t+  exit 1\n761\t+fi\n762\t+exit 0\n763\tdiff --git a/plugins/leadv2/skills/leadv2-supervise/SKILL.md b/plugins/leadv2/skills/leadv2-supervise/SKILL.md\n764\tindex 1f46367..4d7fde0 100644\n765\t--- a/plugins/leadv2/skills/leadv2-supervise/SKILL.md\n766\t+++ b/plugins/leadv2/skills/leadv2-supervise/SKILL.md\n767\t@@ -135,8 +135,10 @@ Only things that need the founder reach chat.\n768\t    - The 30-minute broad status is a `[BROAD_STATUS] ... [BROAD_STATUS_END]`\n769\t      block the loop already writes to `supervise-loop.log` (see\n770\t      `docs/supervisor-role.md` §Status reporting standard for the exact\n771\t-     table shape). Paste that block VERBATIM as one chat turn when it\n772\t-     appears — the lead never hand-composes a status, never re-tables the\n773\t+     table shape). The beat announces itself with ONE\n774\t+     `BROAD_STATUS_READY` line through the URGENT filter — paste\n775\t+     `docs/leadv2/founder-status.md` VERBATIM as one chat turn when that\n776\t+     line wakes you. The lead never hand-composes a status, never re-tables the\n777\t      lane rows, and never spins up a `CronCreate` job to produce one; the\n778\t      cadence is a plugin-owned loop beat (`leadv2-supervise-loop.sh`,\n779\t      `LEADV2_SUPERVISE_BROAD_STATUS_S`), not something the lead schedules.\