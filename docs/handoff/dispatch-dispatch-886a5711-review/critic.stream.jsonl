{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_5a828ac13dce4cd8b270674a","type":"tool_result","content":"400\t+# (liveness/pick retries against an empty control plane), so loop-running\n401\t+# cases use generous timeouts — a cycle completes in ~60s, not ~5s.\n402\t+# Run: bash scripts/tests/test-broad-status-duty.sh\n403\t+\n404\t+set -uo pipefail\n405\t+\n406\t+SCRIPT_DIR=\"$(cd \"$(dirname \"${BASH_SOURCE[0]}\")/..\" && pwd)\"\n407\t+PLUGIN_DIR=\"$(cd \"${SCRIPT_DIR}/..\" && pwd)\"   # plugins/leadv2\n408\t+source \"${SCRIPT_DIR}/leadv2-temp.sh\"\n409\t+\n410\t+LOOP_SH=\"${SCRIPT_DIR}/leadv2-supervise-loop.sh\"\n411\t+BROAD_STATUS_SH=\"${SCRIPT_DIR}/leadv2-broad-status.sh\"\n412\t+WATCHDOG_SH=\"${SCRIPT_DIR}/leadv2-supervise-watchdog.sh\"\n413\t+STATE_PATH_SH=\"${SCRIPT_DIR}/leadv2-state-path.sh\"\n414\t+\n415\t+PASS=0; FAIL=0; ERRORS=()\n416\t+log()  { printf -- '[TEST] %s\\n' \"$*\"; }\n417\t+pass() { PASS=$(( PASS + 1 )); log \"PASS: $1\"; }\n418\t+fail() { FAIL=$(( FAIL + 1 )); ERRORS+=(\"FAIL: $1\"); log \"FAIL: $1\"; }\n419\t+\n420\t+TMP=\"$(lv2_mktemp_dir broad-status-duty)\"\n421\t+REPO=\"$TMP/proj\"\n422\t+STATE=\"$TMP/state\"\n423\t+STUBS=\"$TMP/stubs\"\n424\t+PUMP_COUNTER=\"$TMP/pump-counter\"\n425\t+CRONTAB_STUB_STATE=\"$TMP/crontab-state\"\n426\t+mkdir -p \"$REPO\" \"$STATE\" \"$STUBS\"\n427\t+git -C \"$REPO\" init -q\n428\t+# TEST SAFETY: this suite writes through leadv2-state-path.sh — prove the\n429\t+# fixture is a throwaway before any control-plane write happens.\n430\t+lv2_assert_scratch_repo \"$REPO\"\n431\t+\n432\t+export LEADV2_PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\"\n433\t+\n434\t+LOG_FILE=\"$(PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" bash \"$STATE_PATH_SH\" supervise-loop.log)\"\n435\t+FOUNDER_STATUS=\"$REPO/docs/leadv2/founder-status.md\"\n436\t+ready_count()   { grep -c 'BROAD_STATUS_READY' \"$LOG_FILE\" 2>/dev/null || true; }\n437\t+urgent_count()  { grep 'URGENT' \"$LOG_FILE\" 2>/dev/null | grep -c 'BROAD_STATUS_READY' || true; }\n438\t+started_pids()  { sed -n 's/.*\\[supervise-loop\\] started pid=\\([0-9]*\\) .*/\\1/p' \"$LOG_FILE\" 2>/dev/null; }\n439\t+\n440\t+# ── stubs ──────────────────────────────────────────────────────────────────\n441\t+cat >\"$STUBS/collector.sh\" <<'EOF'\n442\t+#!/usr/bin/env bash\n443\t+# Minimal snapshot: no lanes, no repo_facts — enough for the deterministic\n444\t+# renderer to produce the placeholder table.\n445\t+out=\"\"\n446\t+while [[ $# -gt 0 ]]; do\n447\t+  case \"$1\" in\n448\t+    --out) out=\"$2\"; shift 2 ;;\n449\t+    *) shift ;;\n450\t+  esac\n451\t+done\n452\t+[[ -z \"$out\" ]] && exit 1\n453\t+printf '{\"sections\": {}}' >\"$out\"\n454\t+EOF\n455\t+cat >\"$STUBS/claude.sh\" <<'EOF'\n456\t+#!/usr/bin/env bash\n457\t+# Fixed composer result — no model is called from this suite.\n458\t+printf '{\"result\":\"тестовый хвост: очередь пуста, ничего не приземлилось.\"}'\n459\t+EOF\n460\t+cat >\"$STUBS/pump.sh\" <<EOF\n461\t+#!/usr/bin/env bash\n462\t+# Stub pump: increments a counter on every check (mtime = last run) and logs\n463\t+# the same \"check complete:\" summary line the real pump emits.\n464\t+if [[ \"\\${1:-}\" == \"check\" ]]; then\n465\t+  n=0\n466\t+  [[ -f \"\\$PUMP_COUNTER\" ]] && n=\"\\$(cat \"\\$PUMP_COUNTER\" 2>/dev/null || echo 0)\"\n467\t+  echo \\$((n + 1)) >\"\\$PUMP_COUNTER\"\n468\t+  echo \"check complete: examined=1 dispatched=2 live=0 remaining_capacity=5 below_floor=0\" >&2\n469\t+fi\n470\t+exit 0\n471\t+EOF\n472\t+cat >\"$STUBS/crontab.sh\" <<EOF\n473\t+#!/usr/bin/env bash\n474\t+# Stub crontab: records installs into a state file, never touches the real one.\n475\t+case \"\\${1:-}\" in\n476\t+  -l) cat \"\\$CRONTAB_STUB_STATE\" 2>/dev/null; exit 0 ;;\n477\t+  -)  cat >\"\\$CRONTAB_STUB_STATE\"; exit 0 ;;\n478\t+esac\n479\t+exit 0\n480\t+EOF\n481\t+chmod +x \"$STUBS/collector.sh\" \"$STUBS/claude.sh\" \"$STUBS/pump.sh\" \"$STUBS/crontab.sh\"\n482\t+\n483\t+# Common env for every direct broad-status invocation.\n484\t+beat_env() {  # <beat-at> [extra env assignments via caller]\n485\t+  env LEADV2_PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" \\\n486\t+    LEADV2_STATUS_COLLECTOR_BIN=\"$STUBS/collector.sh\" \\\n487\t+    LEADV2_BROAD_STATUS_CLAUDE_BIN=\"$STUBS/claude.sh\" \\\n488\t+    LEADV2_BROAD_STATUS_BEAT_AT=\"$1\" \\\n489\t+    LEADV2_BROAD_STATUS_DISPATCHED=\"2\" \\\n490\t+    \"${@:2}\"\n491\t+}\n492\t+loop_env() {  # extra env assignments\n493\t+  env LEADV2_PROJECT_ROOT=\"$REPO\" CLAUDE_PROJECT_DIR=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" \\\n494\t+    LEADV2_STATUS_COLLECTOR_BIN=\"$STUBS/collector.sh\" \\\n495\t+    LEADV2_BROAD_STATUS_CLAUDE_BIN=\"$STUBS/claude.sh\" \\\n496\t+    LEADV2_BACKLOG_PUMP_BIN=\"$STUBS/pump.sh\" \\\n497\t+    CRONTAB_BIN=\"$STUBS/crontab.sh\" \\\n498\t+    \"$@\"\n499\t+}\n500\t+wait_for() {  # <desc> <timeout_s> <cmd...> — poll until cmd succeeds\n501\t+  local desc=\"$1\" tmo=\"$2\"; shift 2\n502\t+  local i=0\n503\t+  while (( i < tmo )); do\n504\t+    if \"$@\" >/dev/null 2>&1; then return 0; fi\n505\t+    sleep 1; i=$(( i + 1 ))\n506\t+  done\n507\t+  fail \"$desc (waited ${tmo}s)\"\n508\t+  return 1\n509\t+}\n510\t+\n511\t+cleanup() {\n512\t+  # Kill any loop this suite left behind (sentinel pid), then drop the tree.\n513\t+  local sent pid\n514\t+  sent=\"$(PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" bash \"$STATE_PATH_SH\" .supervise-loop.json 2>/dev/null || true)\"\n515\t+  if [[ -n \"$sent\" && -f \"$sent\" ]]; then\n516\t+    pid=\"$(python3 -c \"import json;print(json.load(open('$sent')).get('pid',0))\" 2>/dev/null || echo 0)\"\n517\t+    [[ \"$pid\" -gt 0 ]] && kill \"$pid\" 2>/dev/null || true\n518\t+  fi\n519\t+  rm -rf \"$TMP\"\n520\t+}\n521\t+trap cleanup EXIT\n522\t+\n523\t+# ── Test 1: ready-line emitted, passes the real filter, artifact written ───\n524\t+beat_env \"2026-08-16T10:00:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n525\t+if [[ -f \"$FOUNDER_STATUS\" ]]; then pass \"T1a: founder-status.md written\"; else fail \"T1a: founder-status.md missing\"; fi\n526\t+if [[ \"$(urgent_count)\" == \"1\" ]]; then pass \"T1b: exactly one URGENT-filtered BROAD_STATUS_READY line\"; else fail \"T1b: expected 1 URGENT BROAD_STATUS_READY line, got $(urgent_count)\"; fi\n527\t+if grep -q 'BROAD_STATUS_READY at=2026-08-16T10:00:00Z path=docs/leadv2/founder-status.md rows=0 dispatched=2$' \"$LOG_FILE\"; then\n528\t+  pass \"T1c: ready-line carries at/path/rows/dispatched\"\n529\t+else\n530\t+  fail \"T1c: ready-line shape wrong: $(grep BROAD_STATUS_READY \"$LOG_FILE\" | tail -1)\"\n531\t+fi\n532\t+if grep -q '\\[BROAD_STATUS\\] dispatched=2$' \"$LOG_FILE\" && grep -q 'dispatched=2' \"$FOUNDER_STATUS\"; then\n533\t+  pass \"T1d: block header + artifact carry the dispatched= stamp\"\n534\t+else\n535\t+  fail \"T1d: dispatched= stamp missing from block/artifact\"\n536\t+fi\n537\t+\n538\t+# ── Test 2: dedupe (same beat suppressed, new beat fires, lib-less R2) ─────\n539\t+beat_env \"2026-08-16T10:00:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n540\t+if [[ \"$(ready_count)\" == \"1\" ]]; then pass \"T2a: same beat re-run -> still one line\"; else fail \"T2a: dedupe failed, $(ready_count) lines\"; fi\n541\t+beat_env \"2026-08-16T10:30:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n542\t+if [[ \"$(ready_count)\" == \"2\" ]]; then pass \"T2b: new beat -> fires\"; else fail \"T2b: expected 2 lines, got $(ready_count)\"; fi\n543\t+beat_env \"2026-08-16T11:00:00Z\" LEADV2_ALARM_DEDUPE_BIN=/nonexistent-lib \\\n544\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n545\t+if [[ \"$(ready_count)\" == \"3\" ]]; then pass \"T2c: lib absent -> pass-through still one line per beat (R2)\"; else fail \"T2c: expected 3 lines, got $(ready_count)\"; fi\n546\t+\n547\t+# ── Test 3: dispatch before report, through the real loop branch ───────────\n548\t+: >\"$LOG_FILE\"; : >\"$PUMP_COUNTER\" 2>/dev/null || true; rm -f \"$PUMP_COUNTER\" \"$FOUNDER_STATUS\"\n549\t+timeout 90 loop_env \\\n550\t+  LEADV2_SUPERVISE_LOOP_MAX_CYCLES=1 LEADV2_SUPERVISE_LOOP_PULSE_ON_START=1 \\\n551\t+  LEADV2_SUPERVISE_EVENT_POLL_S=0 \\\n552\t+  bash \"$LOOP_SH\" >/dev/null 2>&1 || true\n553\t+if [[ -f \"$PUMP_COUNTER\" && -f \"$FOUNDER_STATUS\" ]]; then\n554\t+  ORDER=\"$(python3 -c \"\n555\t+import os, sys\n556\t+pump, status = os.path.getmtime('$PUMP_COUNTER'), os.path.getmtime('$FOUNDER_STATUS')\n557\t+print('before' if pump < status else 'after')\n558\t+\")\"\n559\t+  if [[ \"$ORDER\" == \"before\" ]]; then pass \"T3a: pump ran before founder-status.md was written\"; else fail \"T3a: pump ran AFTER the composer\"; fi\n560\t+else\n561\t+  fail \"T3a: pump counter or founder-status.md missing after one loop cycle\"\n562\t+fi\n563\t+if grep -q 'BROAD_STATUS_READY at=.* path=docs/leadv2/founder-status.md rows=0 dispatched=2' \"$LOG_FILE\"; then\n564\t+  pass \"T3b: loop-run beat stamps the pump's dispatched count\"\n565\t+else\n566\t+  fail \"T3b: no ready-line with dispatched=2 after loop cycle: $(grep BROAD_STATUS_READY \"$LOG_FILE\" || echo none)\"\n567\t+fi\n568\t+\n569\t+# ── Test 4: session-death survival — the demonstration ─────────────────────\n570\t+: >\"$LOG_FILE\"; rm -f \"$PUMP_COUNTER\" \"$FOUNDER_STATUS\"\n571\t+timeout 240 loop_env \\\n572\t+  LEADV2_SUPERVISE_LOOP_PULSE_ON_START=1 LEADV2_SUPERVISE_EVENT_POLL_S=1 \\\n573\t+  LEADV2_SUPERVISE_PULSE_S=2 LEADV2_SUPERVISE_BROAD_STATUS_S=2 \\\n574\t+  bash \"$LOOP_SH\" >/dev/null 2>&1 &\n575\t+T4_LOOP_SHELL=$!\n576\t+wait_for \"T4a: first beat appears\" 120 bash -c \"grep -q BROAD_STATUS_READY '$LOG_FILE'\"\n577\t+OLD_PID=\"$(started_pids | tail -n1)\"\n578\t+# R3: a second --ensure while the loop is live must ADOPT, never spawn.\n579\t+STARTED_BEFORE=\"$(started_pids | grep -c . || true)\"\n580\t+timeout 20 loop_env bash \"$LOOP_SH\" --ensure >/dev/null 2>&1 || true\n581\t+if grep -q 'adopt existing loop pid=' \"$LOG_FILE\" && [[ \"$(started_pids | grep -c . || true)\" == \"$STARTED_BEFORE\" ]]; then\n582\t+  pass \"T4b: double --ensure adopts (no sibling loop, R3)\"\n583\t+else\n584\t+  fail \"T4b: --ensure did not cleanly adopt the live loop\"\n585\t+fi\n586\t+kill \"$OLD_PID\" 2>/dev/null || true\n587\t+sleep 5   # heartbeat ages past 2xPULSE_S=4s AND the pid is dead\n588\t+timeout 240 loop_env LEADV2_SUPERVISE_PULSE_S=2 bash \"$WATCHDOG_SH\" --project-root \"$REPO\" >/dev/null 2>&1 &\n589\t+T4_WD=$!\n590\t+wait_for \"T4c: LOOP_SILENT alarm\" 60 bash -c \"grep -q 'LOOP_SILENT' '$LOG_FILE'\"\n591\t+wait_for \"T4d: replacement loop started\" 90 bash -c \"[[ \\\"\\$(started_pids | tail -n1)\\\" != \\\"$OLD_PID\\\" && -n \\\"\\$(started_pids | tail -n1)\\\" ]]\"\n592\t+NEW_PID=\"$(started_pids | tail -n1)\"\n593\t+wait_for \"T4e: fresh beat from the replacement loop\" 150 bash -c \"[[ \\\"\\$(grep -c BROAD_STATUS_READY '$LOG_FILE')\\\" -ge 2 ]]\"\n594\t+if kill -0 \"$NEW_PID\" 2>/dev/null; then pass \"T4f: replacement loop pid=$NEW_PID is alive (old=$OLD_PID)\"; else fail \"T4f: replacement loop not alive\"; fi\n595\t+kill \"$T4_WD\" \"$NEW_PID\" 2>/dev/null || true\n596\t+wait \"$T4_WD\" 2>/dev/null || true\n597\t+\n598\t+# ── Test 5: degraded beat is visible ───────────────────────────────────────\n599\t+: >\"$LOG_FILE\"\n600\t+env LEADV2_PROJECT_ROOT=\"$REPO\" LEADV2_STATE_ROOT=\"$STATE\" \\\n601\t+  LEADV2_STATUS_COLLECTOR_BIN=/nonexistent-collector \\\n602\t+  LEADV2_BROAD_STATUS_BEAT_AT=\"2026-08-16T12:00:00Z\" \\\n603\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n604\t+if grep -q 'BROAD_STATUS_READY at=.* degraded=1$' \"$LOG_FILE\"; then\n605\t+  pass \"T5: collector failure -> degraded ready-line still wakes\"\n606\t+else\n607\t+  fail \"T5: no degraded=1 ready-line: $(cat \"$LOG_FILE\")\"\n608\t+fi\n609\t+\n610\t+# ── Test 9: a failed beat is visibly failed in the ARTIFACT (fix r1) ───────\n611\t+# T5 asserts the degraded ready-line — the test that passed while the bug was\n612\t+# live. T9 asserts on what the relay would PUBLISH: the artifact bytes.\n613\t+mkdir -p \"$REPO/docs/leadv2\"\n614\t+seed_stale_status() {\n615\t+  printf '2026-08-16T00:00:00Z [BROAD_STATUS] dispatched=0\\n' >\"$FOUNDER_STATUS\"\n616\t+  printf '| Линия | Что делает | Кто делает | Состояние | Уже на диске |\\n' >>\"$FOUNDER_STATUS\"\n617\t+  printf '|---|---|---|---|---|\\n' >>\"$FOUNDER_STATUS\"\n618\t+  printf '| HEALTHY-SENTINEL-DO-NOT-KEEP | всё хорошо | — | тихо 5 мин | — |\\n\\n' >>\"$FOUNDER_STATUS\"\n619\t+  printf 'Всё отлично, ничего не происходит.\\n[BROAD_STATUS_END]\\n' >>\"$FOUNDER_STATUS\"\n620\t+}\n621\t+degraded_assertions() {  # <label> <pinned-beat> <reason-substring>\n622\t+  local label=\"$1\" beat=\"$2\" reason_re=\"$3\"\n623\t+  if grep -q 'HEALTHY-SENTINEL-DO-NOT-KEEP' \"$FOUNDER_STATUS\"; then\n624\t+    fail \"$label: previous healthy table still in founder-status.md\"\n625\t+  else pass \"$label: previous healthy table replaced\"; fi\n626\t+  if grep -q 'СТАТУС НЕ СОБРАН' \"$FOUNDER_STATUS\"; then\n627\t+    pass \"$label: explicit СТАТУС НЕ СОБРАН sentence present\"\n628\t+  else fail \"$label: no СТАТУС НЕ СОБРАН sentence\"; fi\n629\t+  if grep -q \"$beat\" \"$FOUNDER_STATUS\"; then\n630\t+    pass \"$label: pinned beat timestamp present\"\n631\t+  else fail \"$label: pinned beat timestamp missing\"; fi\n632\t+  if head -n1 \"$FOUNDER_STATUS\" | grep -q 'degraded=1'; then\n633\t+    pass \"$label: line 1 carries degraded=1\"\n634\t+  else fail \"$label: line 1 lacks degraded=1: $(head -n1 \"$FOUNDER_STATUS\")\"; fi\n635\t+  if grep -q \"$reason_re\" \"$FOUNDER_STATUS\"; then\n636\t+    pass \"$label: Состояние cell names the failure ($reason_re)\"\n637\t+  else fail \"$label: failure reason missing from the table row\"; fi\n638\t+}\n639\t+\n640\t+# T9a: collector failure replaces the artifact.\n641\t+seed_stale_status; : >\"$LOG_FILE\"\n642\t+beat_env \"2026-08-16T12:30:00Z\" LEADV2_STATUS_COLLECTOR_BIN=/bin/false \\\n643\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n644\t+degraded_assertions \"T9a\" \"2026-08-16T12:30:00Z\" 'collector failed'\n645\t+\n646\t+# T9b: render failure (invalid JSON snapshot) replaces the artifact — the\n647\t+# failure path the review did not name.\n648\t+cat >\"$STUBS/bad-collector.sh\" <<'EOF'\n649\t+#!/usr/bin/env bash\n650\t+# Writes a snapshot that is NOT valid JSON -> the deterministic render fails.\n651\t+out=\"\"\n652\t+while [[ $# -gt 0 ]]; do\n653\t+  case \"$1\" in\n654\t+    --out) out=\"$2\"; shift 2 ;;\n655\t+    *) shift ;;\n656\t+  esac\n657\t+done\n658\t+[[ -z \"$out\" ]] && exit 1\n659\t+printf 'this-is-not-json' >\"$out\"\n660\t+EOF\n661\t+chmod +x \"$STUBS/bad-collector.sh\"\n662\t+seed_stale_status; : >\"$LOG_FILE\"\n663\t+beat_env \"2026-08-16T13:00:00Z\" LEADV2_STATUS_COLLECTOR_BIN=\"$STUBS/bad-collector.sh\" \\\n664\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n665\t+degraded_assertions \"T9b\" \"2026-08-16T13:00:00Z\" 'render failed'\n666\t+\n667\t+# T9c: stamp coherence (P2) — the ready-line's at= always equals the leading\n668\t+# timestamp of founder-status.md line 1, healthy beat AND degraded beat, so a\n669\t+# reader can detect staleness without trusting the writer.\n670\t+stamp_coherence_check() {  # <label>\n671\t+  local label=\"$1\" at_val line1_ts\n672\t+  at_val=\"$(sed -n 's/.*BROAD_STATUS_READY at=\\([^ ]*\\).*/\\1/p' \"$LOG_FILE\" | tail -n1)\"\n673\t+  line1_ts=\"$(head -n1 \"$FOUNDER_STATUS\" | awk '{print $1}')\"\n674\t+  if [[ -n \"$at_val\" && \"$at_val\" == \"$line1_ts\" ]]; then\n675\t+    pass \"$label: ready-line at= == founder-status.md line-1 timestamp\"\n676\t+  else\n677\t+    fail \"$label: stamp mismatch: ready at=$at_val file line1=$line1_ts\"\n678\t+  fi\n679\t+}\n680\t+seed_stale_status; : >\"$LOG_FILE\"\n681\t+beat_env \"2026-08-16T13:30:00Z\" bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n682\t+stamp_coherence_check \"T9c-healthy\"\n683\t+beat_env \"2026-08-16T14:00:00Z\" LEADV2_STATUS_COLLECTOR_BIN=/bin/false \\\n684\t+  bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n685\t+stamp_coherence_check \"T9c-degraded\"\n686\t+\n687\t+# T9d: artifact unwritable -> READY refused, stale file kept byte-identical.\n688\t+if [[ \"${EUID:-$(id -u)}\" -eq 0 ]]; then\n689\t+  log \"SKIP: T9d (running as root — chmod 500 does not block writes)\"\n690\t+else\n691\t+  RO_DIR=\"$TMP/ro-status\"; mkdir -p \"$RO_DIR\"\n692\t+  printf 'STALE-BYTES-KEEP\\n' >\"$RO_DIR/founder-status.md\"\n693\t+  STALE_COPY=\"$TMP/t9d-stale-copy\"; cp \"$RO_DIR/founder-status.md\" \"$STALE_COPY\"\n694\t+  chmod 500 \"$RO_DIR\"\n695\t+  : >\"$LOG_FILE\"\n696\t+  beat_env \"2026-08-16T14:30:00Z\" LEADV2_FOUNDER_STATUS_PATH=\"$RO_DIR/founder-status.md\" \\\n697\t+    LEADV2_STATUS_COLLECTOR_BIN=/bin/false bash \"$BROAD_STATUS_SH\" >/dev/null 2>&1 || true\n698\t+  chmod 700 \"$RO_DIR\"   # restore mode BEFORE suite teardown (fixture-leak risk)\n699\t+  if [[ \"$(ready_count)\" == \"0\" ]]; then\n700\t+    pass \"T9d: unwritable artifact -> zero BROAD_STATUS_READY lines\"\n701\t+  else\n702\t+    fail \"T9d: READY advertised a file it could not write ($(ready_count) lines)\"\n703\t+  fi\n704\t+  t9d_failed=\"$(grep -c 'BROAD_STATUS_FAILED .*stale_file_kept=1' \"$LOG_FILE\" 2>/dev/null || true)\"\n705\t+  if [[ \"$t9d_failed\" == \"1\" ]]; then\n706\t+    pass \"T9d: exactly one BROAD_STATUS_FAILED stale_file_kept=1\"\n707\t+  else\n708\t+    fail \"T9d: expected 1 BROAD_STATUS_FAILED line, got $t9d_failed: $(grep BROAD_STATUS_FAILED \"$LOG_FILE\" || echo none)\"\n709\t+  fi\n710\t+  if cmp -s \"$RO_DIR/founder-status.md\" \"$STALE_COPY\"; then\n711\t+    pass \"T9d: stale file byte-identical (nothing half-wrote it)\"\n712\t+  else\n713\t+    fail \"T9d: stale file was modified despite the unwritable dir\"\n714\t+  fi\n715\t+fi\n716\t+\n717\t+# ── Test 6: kill-switch disables beat AND ready-line ────────────────────────\n718\t+: >\"$LOG_FILE\"; rm -f \"$FOUNDER_STATUS\"\n719\t+timeout 40 loop_env \\\n720\t+  LEADV2_