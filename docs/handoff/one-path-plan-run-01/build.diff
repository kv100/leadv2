+# ---------------------------------------------------------------------------
+printf -- '\n'
+for e in "${ERRORS[@]}"; do printf -- '  FAIL: %s\n' "${e}"; done
+printf -- 'Results: %d pass, %d fail\n' "${PASS}" "${FAIL}"
+[[ "${FAIL}" == "0" ]] || exit 1
+exit 0
