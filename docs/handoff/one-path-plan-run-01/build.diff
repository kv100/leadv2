+  else
+    fail "engine plan-gate.md status='${_status5}' (expected pass)"
+  fi
+else
+  fail "engine did not produce pass gate (rc=${rc5})"
+  log "  stderr: $(cat "${TMP}/test5-stderr.log" 2>/dev/null | tail -5)"
