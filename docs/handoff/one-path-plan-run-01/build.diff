+cat > "${TMP}/stub-quota.sh" <<'SH'
+#!/usr/bin/env bash
+case "$1" in
+  anthropic|opus|sonnet|fable) printf '{"status":"ok","five_hour":{"pct":10.0},"weekly":{"pct":10.0}}\n' ;;
+  *) printf '{"status":"ok","five_hour":{"pct":10.0},"weekly":{"pct":10.0}}\n' ;;
