{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PLUGIN_ROOT/hooks/lv2guard-pretooluse.sh\""
          }
        ]
      }
    ],
    "SubagentStart": [{"matcher":".*","hooks":[{"type":"command","command":"bash \"$CLAUDE_PLUGIN_ROOT/hooks/leadv2-subagent-lifecycle.sh\" start"}]}],
    "SubagentStop": [{"matcher":".*","hooks":[{"type":"command","command":"bash \"$CLAUDE_PLUGIN_ROOT/hooks/leadv2-subagent-lifecycle.sh\" stop"}]}]
  }
}
