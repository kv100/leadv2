{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "leadv2-workflow-receipt",
  "title": "Leadv2 Fixed Workflow Step Receipt",
  "description": "One terminal receipt for a fixed-shape workflow step, appended externally to the workflow receipt ledger. terminal_status remains in the denominator for every terminal outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_version", "workflow_run_id", "step_id", "attempt", "input_digest", "admitted_W", "admitted_R", "admitted_arbiter_decision", "arbiter_decision", "decision_matches_admission", "terminal_status", "actual_steps", "actual_rounds", "shape_realized", "dispatch_exit_code", "dispatch_output_digest"],
  "properties": {
    "receipt_version": {"const": 1},
    "workflow_run_id": {"type": "string", "minLength": 1},
    "step_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "admitted_W": {"type": "integer", "minimum": 1},
    "admitted_R": {"type": "integer", "minimum": 1},
    "admitted_arbiter_decision": {"type": "object", "additionalProperties": false, "required": ["arm", "model", "tier", "effort"], "properties": {"arm": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "tier": {"type": "string", "minLength": 1}, "effort": {"type": "string", "minLength": 1}}},
    "arbiter_decision": {"type": ["object", "null"], "additionalProperties": false, "required": ["arm", "model", "tier", "effort"], "properties": {"arm": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "tier": {"type": "string", "minLength": 1}, "effort": {"type": "string", "minLength": 1}}},
    "decision_matches_admission": {"type": "boolean"},
    "terminal_status": {"enum": ["completed", "blocked_control_plane", "unknown_completion", "budget_exhausted"]},
    "actual_steps": {"type": "integer", "minimum": 0},
    "actual_rounds": {"type": "integer", "minimum": 0},
    "shape_realized": {"type": "boolean"},
    "dispatch_exit_code": {"type": "integer"},
    "dispatch_output_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
