# RUNNER-LEAKS-ITS-LOCK-FLAG-INTO-THE-SUITES-IT-RUNS-01: this suite tests real
# flock acquisition in $RUNNER, which only attempts it while
# _LV2_CORE_OFFLINE_LOCK_HELD is unset/not "1" (see run-core-offline.sh's
# top-level guard). If this suite's OWN process ever inherits that flag —
# whether from a real runner leak or from anything else in its ambient
# environment — every `env ... bash "$RUNNER"` call below would forward it
# straight through (`env` adds/overrides, it does not strip inherited vars),
# so $RUNNER would believe it already holds the lock and skip acquisition
# entirely, turning every case here into a false pass/fail regardless of the
# real lock behaviour. Unset it once, up front, so this suite's own
# hermeticity does not depend on whatever unset the runner's leak.
unset _LV2_CORE_OFFLINE_LOCK_HELD
